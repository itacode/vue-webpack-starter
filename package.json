{
  "name": "vue-webpack-starter",
  "version": "1.0.0",
  "description": "Easily add vue to an existing page.",
  "main": "src/app/main.ts",
  "scripts": {
    "dev": "webpack serve --config-node-env development --mode=development --env platform=development --progress",
    "build": "webpack --config-node-env production --mode=production --env platform=production --progress",
    "test": "jest --passWithNoTests",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint ./src/app/",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^8.0.10",
    "axios": "^1.21.0",
    "core-js": "^3.51.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.5.1",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-webpack-plugin": "^6.0.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vue-loader": "^17.4.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
