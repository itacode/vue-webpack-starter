{
  "name": "vue-webpack-starter",
  "version": "1.0.0",
  "description": "Easily add vue to an existing page.",
  "main": "src/app/main.ts",
  "scripts": {
    "dev": "webpack serve --config-node-env development --mode=development --env platform=development --progress",
    "build": "webpack --config-node-env production --mode=production --env platform=production --progress",
    "test": "jest --passWithNoTests",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint ./src/app/",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "axios": "^1.19.0",
    "core-js": "^3.50.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vue/test-utils": "^2.4.11",
    "@vue/vue3-jest": "^29.2.6",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-webpack-plugin": "^6.0.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vue-loader": "^17.4.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
